#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            display-name = "Base";
            bindings = <
&kp ESCAPE  &none  &none  &kp N3  &kp N4  &kp N5  &none                                                           &mo 3      &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &none
&kp CAPS    &kp Q  &kp W  &kp E   &kp R   &kp T   &none                                                           &none      &kp Y   &kp U   &kp I   &kp O   &kp P   &none
&kp TAB     &kp A  &kp S  &kp D   &kp F   &kp G   &none     &kp LEFT_CONTROL  &kp LALT      &kp LGUI  &kp ESCAPE  &none      &kp H   &kp J   &kp K   &kp L   &none   &none
&kp LSHFT   &kp Z  &kp X  &kp C   &kp V   &kp B                               &mo 3         &mo 4                            &kp N   &kp M   &none   &none   &none   &kp RSHFT
&mo 2       &none  &none  &none   &none           &kp BSPC  &kp DELETE        &tog 1        &mo 2     &kp ENTER   &kp SPACE          &none   &none   &none   &none   &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp ESCAPE    &none  &none  &none  &none  &none  &none                                                    &none      &none  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &none
&kp CAPSLOCK  &none  &none  &none  &none  &none  &none                                                    &none      &none  &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &none
&kp TAB       &none  &none  &none  &none  &none  &none     &kp LCTRL  &kp LALT      &kp LGUI  &kp ESCAPE  &none      &none  &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &none
&kp LSHFT     &none  &none  &none  &none  &none                       &trans        &trans                           &none  &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2         &none  &none  &none  &none         &kp BSPC  &kp DEL    &trans        &trans    &kp ENTER   &kp SPACE         &none       &none         &kp KP_DOT     &none            &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        navigation {
            display-name = "mod";
            bindings = <
&none           &bt BT_SEL 0     &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none           &none            &none             &none                 &none                  &none
&none           &kp EXCLAMATION  &kp AMPERSAND  &kp POUND     &kp DOLLAR    &kp PERCENT   &bootloader                                            &bootloader      &kp CARET       &kp AMPERSAND    &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none
&studio_unlock  &kp PLUS         &kp EQUAL      &kp MINUS     &kp UNDER     &kp GRAVE     &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &kp LEFT_ARROW  &kp DOWN_ARROW   &kp UP_ARROW      &kp RIGHT             &none                  &none
&none           &none            &kp DELETE     &none         &macro_ver    &none                             &none      &none                                    &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &none                  &none
&none           &none            &none          &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                  &bl BL_INC       &bl BL_DEC        &none                 &none                  &none
            >;
        };

        symbols {
            bindings = <
&trans  &trans            &trans          &trans                &trans         &trans       &trans                                      &trans  &trans         &trans            &trans                 &trans           &trans             &trans
&trans  &kp EXCLAMATION   &kp AT_SIGN     &kp HASH              &kp DOLLAR     &kp PERCENT  &trans                                      &trans  &kp CARET      &kp AMPERSAND     &kp ASTERISK           &kp PLUS         &kp MINUS          &trans
&trans  &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp LESS_THAN  &kp COLON    &trans  &trans  &trans      &trans  &trans  &trans  &kp SEMICOLON  &kp GREATER_THAN  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &trans
&trans  &kp PIPE          &kp QUESTION    &kp GRAVE             &kp TILDE      &kp COMMA                    &trans      &trans                  &kp PERIOD     &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES      &kp SLASH        &kp BACKSLASH      &trans
&trans  &trans            &trans          &trans                &trans                      &trans  &trans  &trans      &trans  &trans  &trans                 &trans            &trans                 &trans           &trans             &trans
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
