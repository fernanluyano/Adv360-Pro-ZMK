#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&mt { tapping-term-ms = <400>; };

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            display-name = "Base";
            bindings = <
&kp EQUAL   &kp NUMBER_1  &kp NUMBER_2  &kp N3            &kp N4             &kp N5  &tog 1                                                                                 &none        &kp N6             &kp N7             &kp N8                 &kp N9                  &kp N0          &kp MINUS
&kp ESCAPE  &kp Q         &kp W         &kp E             &kp R              &kp T   &none                                                                                  &none        &kp Y              &mt KP_NUMBER_7 U  &mt KP_NUMBER_8 I      &mt KP_NUMBER_9 O       &kp P           &kp BACKSLASH
&kp TAB     &mt LC(A) A   &kp S         &kp D             &mt LC(F) F        &kp G   &none     &mt LEFT_CONTROL ESCAPE  &kp LALT      &mt RIGHT_ALT LGUI  &mt RCTRL ESCAPE  &none        &kp H              &mt KP_NUMBER_4 J  &mt KP_NUMBER_5 K      &mt KP_NUMBER_6 L       &kp SEMICOLON   &kp SQT
&kp LSHFT   &kp Z         &kp X         &mt LC(C) C       &mt LC(V) V        &kp B                                      &kp HOME      &kp PAGE_UP                                        &mt KP_NUMBER_0 N  &mt KP_NUMBER_1 M  &mt KP_NUMBER_2 COMMA  &mt KP_NUMBER_3 PERIOD  &kp SLASH       &kp RSHFT
&mo 3       &kp CAPSLOCK  &kp GRAVE     &kp LEFT_BRACKET  &kp RIGHT_BRACKET          &kp BSPC  &lt 2 DELETE             &kp END       &kp PAGE_DOWN       &kp ENTER         &lt 2 SPACE                     &kp LEFT_ARROW     &kp RIGHT_ARROW        &kp UP                  &kp DOWN_ARROW  &mo 3
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&trans  &none  &none  &none  &none  &none  &tog 1                                      &none   &none            &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &none
&trans  &none  &none  &none  &none  &none  &none                                       &none   &none            &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &none
&trans  &none  &none  &none  &none  &none  &none   &trans  &trans      &trans  &trans  &none   &none            &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &none
&trans  &none  &none  &none  &none  &none                  &trans      &trans                  &kp KP_NUMBER_0  &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &none
&trans  &none  &none  &none  &none         &trans  &trans  &trans      &trans  &trans  &trans                   &none       &none         &kp KP_DOT     &none            &none
            >;
        };

        symbols {
            bindings = <
&trans  &trans                &trans                 &trans          &trans           &trans            &trans                                      &trans  &trans            &trans          &trans        &trans            &trans             &trans
&trans  &kp EXCLAMATION       &kp AT_SIGN            &kp HASH        &kp DOLLAR       &kp PERCENT       &trans                                      &trans  &kp CARET         &kp AMPERSAND   &kp ASTERISK  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &mt BACKSLASH PIPE
&trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_BRACKET  &trans  &trans  &trans      &trans  &trans  &trans  &kp LEFT_ARROW    &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW   &kp RIGHT_BRACKET  &none
&trans  &kp UNDERSCORE        &kp MINUS              &kp EQUAL       &kp PLUS         &kp LESS_THAN                     &trans      &trans                  &kp GREATER_THAN  &kp PERIOD      &kp COMMA     &kp QUESTION      &kp SLASH          &none
&trans  &trans                &kp GRAVE              &kp TILDE       &kp DELETE                         &trans  &trans  &trans      &trans  &trans  &trans                    &none           &none         &none             &none              &none
            >;
        };

        fn {
            display-name = "combos";
            bindings = <
&kp F1  &kp F2  &kp F3         &kp F4  &kp F5  &kp F6  &none                                       &mo 2   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans         &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &kp LS(LG(S))  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans         &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans         &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };
    };
};
