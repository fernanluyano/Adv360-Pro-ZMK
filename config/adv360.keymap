#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt { tapping-term-ms = <400>; };

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            display-name = "Base";
            bindings = <
&kp EQUAL   &kp NUMBER_1  &kp NUMBER_2  &kp N3            &kp N4             &kp N5  &tog 1                                                                                        &mo 4         &kp N6  &kp N7          &kp N8           &kp N9      &kp N0          &kp MINUS
&kp ESCAPE  &kp Q         &kp W         &kp E             &kp R              &kp T   &kp C_BRI_UP                                                                                  &kp C_VOL_UP  &kp Y   &kp U           &kp I            &kp O       &kp P           &kp BACKSLASH
&kp TAB     &hm LG(A) A   &kp S         &kp D             &kp F              &kp G   &kp C_BRIGHTNESS_DEC  &mt LEFT_CONTROL ESCAPE  &kp LALT      &kp RGUI       &mt RCTRL ESCAPE  &kp C_VOL_DN  &kp H   &kp J           &kp K            &kp L       &kp SEMICOLON   &kp SQT
&kp LSHFT   &kp Z         &kp X         &hm LG(C) C       &hm LG(V) V        &kp B                                                  &kp HOME      &kp PAGE_UP                                    &kp N   &kp M           &kp COMMA        &kp PERIOD  &kp SLASH       &kp RSHFT
&mo 3       &kp CAPSLOCK  &kp GRAVE     &kp LEFT_BRACKET  &kp RIGHT_BRACKET          &kp BSPC              &mo 2                    &kp END       &kp PAGE_DOWN  &kp ENTER         &kp SPACE             &kp LEFT_ARROW  &kp RIGHT_ARROW  &kp UP      &kp DOWN_ARROW  &mo 3
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&trans  &none  &none  &none  &none  &none  &tog 1                                      &none            &none  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &none
&trans  &none  &none  &none  &none  &none  &none                                       &none            &none  &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &none
&trans  &none  &none  &none  &none  &none  &none   &trans  &trans      &trans  &trans  &none            &none  &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &none
&trans  &none  &none  &none  &none  &none                  &trans      &trans                           &none  &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &none
&trans  &none  &none  &none  &none         &trans  &trans  &trans      &trans  &trans  &kp KP_NUMBER_0         &none       &none         &kp KP_DOT     &none            &none
            >;
        };

        symbols {
            bindings = <
&trans  &trans                &trans                 &trans          &trans           &trans            &trans                                        &trans     &trans            &trans          &trans        &trans            &trans             &trans
&trans  &kp EXCLAMATION       &kp AT_SIGN            &kp HASH        &kp DOLLAR       &kp PERCENT       &trans                                        &trans     &kp CARET         &kp AMPERSAND   &kp ASTERISK  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &mt BACKSLASH PIPE
&trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_BRACKET  &kp SEMI  &trans  &trans      &trans  &trans  &kp COLON  &kp LEFT_ARROW    &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW   &kp RIGHT_BRACKET  &none
&trans  &kp UNDERSCORE        &kp MINUS              &kp EQUAL       &kp PLUS         &kp LESS_THAN                       &trans      &trans                     &kp GREATER_THAN  &kp PERIOD      &kp COMMA     &kp QUESTION      &kp SLASH          &none
&trans  &trans                &kp GRAVE              &kp TILDE       &kp DELETE                         &trans    &trans  &trans      &trans  &trans  &trans                       &none           &none         &none             &none              &none
            >;
        };

        fn {
            display-name = "combos";
            bindings = <
&kp F1  &kp F2                 &kp F3                 &kp F4                 &kp F5                 &kp F6                 &none                                                &mo 2                 &kp F7                 &kp F8                 &kp F9                 &kp F10                &kp F11                &kp F12
&trans  &kp LS(LG(LA(LC(Q))))  &kp LS(LA(LC(LG(W))))  &kp LS(LA(LC(LG(E))))  &kp LS(LA(LC(LG(R))))  &kp LS(LA(LC(LG(T))))  &kp C_VOLUME_UP                                      &kp C_BRIGHTNESS_INC  &kp LS(LA(LC(LG(Y))))  &kp LS(LA(LC(LG(U))))  &kp LS(LA(LC(LG(I))))  &kp LS(LA(LC(LG(O))))  &kp LS(LA(LC(LG(P))))  &trans
&trans  &kp LS(LA(LC(LG(A))))  &kp LS(LG(LA(LC(S))))  &kp LS(LA(LC(LG(D))))  &kp LS(LA(LC(LG(F))))  &kp LS(LA(LC(LG(G))))  &kp C_VOL_DN     &trans  &trans      &trans  &trans  &kp C_BRIGHTNESS_DEC  &kp LS(LA(LC(LG(H))))  &kp LS(LA(LC(LG(J))))  &kp LS(LA(LC(LG(K))))  &kp LS(LA(LC(LG(L))))  &trans                 &trans
&trans  &kp LS(LA(LC(LG(Z))))  &kp LS(LA(LC(LG(X))))  &kp LS(LA(LC(LG(C))))  &kp LS(LA(LC(LG(V))))  &kp LS(LA(LC(LG(B))))                           &trans      &trans                                &kp LS(LA(LC(LG(N))))  &kp LS(LA(LC(LG(M))))  &trans                 &trans                 &trans                 &trans
&trans  &trans                 &trans                 &trans                 &trans                                        &trans           &trans  &trans      &trans  &trans  &trans                                       &trans                 &trans                 &trans                 &trans                 &trans
            >;
        };

        system {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                            &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0                                      &bl BL_TOG    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 1  &trans  &trans      &trans  &trans  &bl BL_CYCLE  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                        &trans      &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans        &trans  &trans      &trans  &trans  &trans                &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
